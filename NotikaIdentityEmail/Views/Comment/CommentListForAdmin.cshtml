@using Entity_Layer.DTOs.CommentDtos
@model List<CommentListForAdminDto>

@{
    ViewData["Title"] = "CommentListForAdmin";
    Layout = "~/Views/UserLayout/Index.cshtml";
    int count = 0;
}

<style>
    /* Pagination Stilleri */
    .pagination-container {
        margin-top: 20px;
        text-align: center;
    }

    .pagination {
        display: inline-flex;
        list-style: none;
        padding: 0;
    }

        .pagination li {
            margin: 0 3px;
        }

            .pagination li a {
                color: #333;
                padding: 8px 16px;
                text-decoration: none;
                border: 1px solid #ddd;
                border-radius: 4px;
            }

            .pagination li.active a {
                background-color: #00c292;
                color: white;
                border: 1px solid #00c292;
            }

    /* İşlem Butonları Arası Boşluk */
    .btn-action-group .btn {
        margin-right: 2px;
    }
</style>

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Yorum Yönetim Paneli</h2>
                        <p>Yorumları onaylayabilir, reddedebilir veya detaylarını inceleyebilirsiniz.</p>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered" id="commentTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Yapan Kişi</th>
                                    <th>Başlık</th>
                                    <th>Durum</th>
                                    <th>Tarih</th>
                                    <th style="width: 250px;">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.SenderName</td>
                                        <td>@item.Subject</td>
                                        <td>
                                            @if (item.CommentStatus == null)
                                            {
                                                <span class="label label-warning">Beklemede</span>
                                            }
                                            else if (item.CommentStatus == true)
                                            {
                                                <span class="label label-success">Onaylandı</span>
                                            }
                                            else
                                            {
                                                <span class="label label-danger">Reddedildi</span>
                                            }
                                        </td>
                                        <td>@item.Date.ToString("dd MMM yyyy - HH:mm")</td>
                                        <td class="btn-action-group">
                                            <button class="btn btn-info btn-sm btn-detail"
                                                    data-subject="@item.Subject"
                                                    data-detail="@item.CommentDetail"
                                                    data-sender="@item.SenderName"
                                                    data-date="@item.Date.ToString("dd MMMM yyyy HH:mm")">
                                                Detay
                                            </button>

                                            @if (item.CommentStatus == null)
                                            {
                                                <button class="btn btn-success btn-sm btn-status" data-id="@item.Id" data-status="true">Onayla</button>
                                                <button class="btn btn-danger btn-sm btn-status" data-id="@item.Id" data-status="false">Reddet</button>
                                            }
                                            else if (item.CommentStatus == true)
                                            {
                                                <button class="btn btn-danger btn-sm btn-status" data-id="@item.Id" data-status="false">Pasifleştir</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-success btn-sm btn-status" data-id="@item.Id" data-status="true">Aktifleştir</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination-container">
                        <ul class="pagination" id="paginationList"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // --- Pagination Mantığı ---
            const rowsPerPage = 12;
            const $tableBody = $("#commentTable tbody");
            const $rows = $tableBody.find("tr");
            const rowsCount = $rows.length;
            const pageCount = Math.ceil(rowsCount / rowsPerPage);
            const $paginationList = $("#paginationList");

            function displayPage(page) {
                const start = (page - 1) * rowsPerPage;
                const end = start + rowsPerPage;
                $rows.hide().slice(start, end).show();
                $paginationList.find("li").removeClass("active");
                $paginationList.find(`li[data-page='${page}']`).addClass("active");
            }

            if (pageCount > 1) {
                for (let i = 1; i <= pageCount; i++) {
                    $paginationList.append(`<li class="page-item" data-page="${i}"><a href="javascript:void(0)">${i}</a></li>`);
                }
            }
            $(document).on("click", ".page-item", function () { displayPage($(this).data("page")); });
            displayPage(1);

            // --- Detay Göster ---
            $(document).on("click", ".btn-detail", function () {
                Swal.fire({
                    title: `<strong>${$(this).data("subject")}</strong>`,
                    icon: 'info',
                    html: `<div style="text-align: left;"><p><strong>Yazan:</strong> ${$(this).data("sender")}</p><p><strong>Tarih:</strong> ${$(this).data("date")}</p><hr><p>${$(this).data("detail")}</p></div>`,
                    confirmButtonText: 'Kapat',
                    confirmButtonColor: '#00c292'
                });
            });

            // --- Durum Güncelleme (Aktifleştir/Pasifleştir) ---
            $(document).on("click", ".btn-status", function () {
                const id = $(this).data("id");
                const status = $(this).data("status"); // true veya false gelir
                const title = status === true ? "Onaylamak istediğinize emin misiniz?" : "Pasifleştirmek istediğinize emin misiniz?";

                Swal.fire({
                    title: title,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: status === true ? '#00c292' : '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            type: "POST",
                            url: "/Comment/UpdateCommentStatus",
                            // JSON gönderimi için contentType ve stringify önemli
                            contentType: "application/json",
                            data: JSON.stringify({ Id: id, CommentStatus: status }),
                            success: function (response) {
                                if (response.success || response === true) {
                                    Swal.fire('Başarılı!', 'Yorum durumu güncellendi.', 'success').then(() => {
                                        location.reload(); // Durum değişikliğini yansıtmak için en temiz yol
                                    });
                                } else {
                                    Swal.fire('Hata!', 'İşlem gerçekleştirilemedi.', 'error');
                                }
                            },
                            error: function() {
                                Swal.fire('Hata!', 'Sunucuyla bağlantı kurulamadı.', 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}