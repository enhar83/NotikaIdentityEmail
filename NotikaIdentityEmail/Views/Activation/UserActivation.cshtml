@using Entity_Layer.DTOs.AppUserDtos.ConfirmUserDto
@model ConfirmUserDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Aktivasyon Kodu Sayfası</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="/Login_v4/images/icons/favicon.ico" />
    <link rel="stylesheet" type="text/css" href="/Login_v4/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="/Login_v4/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" type="text/css" href="/Login_v4/fonts/iconic/css/material-design-iconic-font.min.css">
    <link rel="stylesheet" type="text/css" href="/Login_v4/vendor/animate/animate.css">
    <link rel="stylesheet" type="text/css" href="/Login_v4/vendor/css-hamburgers/hamburgers.min.css">
    <link rel="stylesheet" type="text/css" href="/Login_v4/vendor/animsition/css/animsition.min.css">
    <link rel="stylesheet" type="text/css" href="/Login_v4/vendor/select2/select2.min.css">
    <link rel="stylesheet" type="text/css" href="/Login_v4/vendor/daterangepicker/daterangepicker.css">
    <link rel="stylesheet" type="text/css" href="/Login_v4/css/util.css">
    <link rel="stylesheet" type="text/css" href="/Login_v4/css/main.css">
</head>
<body>

    <div class="limiter">
        <div class="container-login100" style="background-image: url('/Login_v4/images/bg-01.jpg');">
            <div class="wrap-login100 p-l-55 p-r-55 p-t-65 p-b-54">

                <form class="login100-form validate-form" method="post" asp-action="UserActivation">
                    <input type="hidden" asp-for="Email" />

                    <span class="login100-form-title p-b-30">
                        E-Mail Validasyon
                    </span>

                    @if (TempData["ActivationMessage"] != null)
                    {
                        <div class="alert alert-warning text-center m-b-20" style="background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; padding: 12px; border-radius: 5px; font-size: 13px; line-height: 1.5;">
                            <i class="fa fa-info-circle m-r-5"></i> @TempData["ActivationMessage"]
                        </div>
                    }
                    @if (TempData["SuccessResendMessage"] != null)
                    {
                        <div class="alert alert-success text-center" role="alert">
                            @TempData["SuccessResendMessage"]
                        </div>
					}
                    @if (TempData["ErrorResendMessage"] != null)
                    {
                        <div class="alert alert-danger text-center" role="alert">
                            @TempData["ErrorResendMessage"]
                        </div>
					}

                    <div class="p-b-30 text-center">
                        <span style="font-size: 14px; color: #666;">
                            <strong>@Model.Email</strong> adresine gönderilen 6 haneli doğrulama kodunu giriniz.
                        </span>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger p-b-20"></div>

                    <div class="wrap-input100 validate-input m-b-23">
                        <span class="label-input100">Aktivasyon Kodu</span>

                        <input class="input100" type="text" asp-for="ActivationCode" placeholder="6 Haneli Kod..." maxlength="6">

                        <span class="focus-input100" data-symbol="&#xf206;"></span>
                    </div>

                    <div class="p-b-20">
                        <span asp-validation-for="ActivationCode" class="text-danger"></span>
                    </div>

                    <div class="container-login100-form-btn">
                        <div class="wrap-login100-form-btn">
                            <div class="login100-form-bgbtn"></div>
                            <button class="login100-form-btn" type="submit">
                                Hesabı Doğrula
                            </button>
                        </div>
                    </div>

                    <div class="flex-col-c p-t-25">
                        <span class="txt1 p-b-17">
                            Kod gelmedi mi?
                        </span>
                        <a asp-action="ResendCode" asp-controller="Activation" asp-route-email="@Model.Email" class="txt2">
                            Tekrar Kod Gönder
                        </a>

                        @* Form İçinde (POST): Formun içinde emaili input type="hidden" asp-for="Email" diyerek taşıdık. Hesabı Doğrula butonuna basılınca tarayıcı formun içindeki tüm kutucukları (hidden olan dahil) paketler ve sunucuya gönderir. Bu yüzden URL'de bir şey görmeye gerek kalmaz.
                        Link ile (GET): Tekrar Gönder bir butondan ziyade bir linktir. Linklere tıklandığında form paketlemesi yapmaz, doğrudan bir URL'ye gitmeye çalışır. *@

                        @* asp-rote-helper tag helperı, dinamik bir URL oluşturur. bu kod yazıldığında ASP.NET Core arka planda şunu üretir.
                            href="/Activation/ResendCode?email=enharyrlmz@gmail.com" (ya da hangi mail adresiyse)
                        Eğer bu asp-route-email kısmı yazılmazsa link sadece /Activation/ResendCode adresine gider ve string mail parametresi null gelir. Sunucuda hangi kullanıcıya kod göndereceğini bilemez. *@
                    
                        @* Form (POST): Veri input (hidden veya normal) ile taşınır.
                        Link (GET): Veri asp-route-degeriismi olarak taşınır.

                        Yani kısacası asp-route-isimi ike aslında URL'nin sonunda hangi eposta varsa linke o mühürlenmiş olur. *@
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="dropDownSelect1"></div>

    <script src="/Login_v4/vendor/jquery/jquery-3.2.1.min.js"></script>
    <script src="/Login_v4/vendor/animsition/js/animsition.min.js"></script>
    <script src="/Login_v4/vendor/bootstrap/js/popper.js"></script>
    <script src="/Login_v4/vendor/bootstrap/js/bootstrap.min.js"></script>
    <script src="/Login_v4/vendor/select2/select2.min.js"></script>
    <script src="/Login_v4/vendor/daterangepicker/moment.min.js"></script>
    <script src="/Login_v4/vendor/daterangepicker/daterangepicker.js"></script>
    <script src="/Login_v4/vendor/countdowntime/countdowntime.js"></script>
    <script src="/Login_v4/js/main.js"></script>

</body>
</html>

<style>
    .text-danger {
        color: #ff0000 !important;
        font-size: 13px;
        text-align: center;
        display: block;
    }
</style>