@model UpdateCategoryDto

@{
    ViewData["Title"] = "EditCategory";
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2><i class="@Model.CategoryIconUrl"></i> Kategori Düzenleme</h2>
                        <p>Lütfen kategori bilgilerini eksiksiz olarak doldurup güncelleme işlemini yapınız.</p>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger m-b-20"></div>

                    <form asp-action="EditCategory" asp-controller="Category" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="fa fa-tag"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label>Kategori Adı</label>
                                        <input type="text" asp-for="CategoryName" class="form-control" placeholder="Kategori Adı">
                                    </div>
                                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp">
                                        <i class="@Model.CategoryIconUrl" id="icon-preview"></i>
                                    </div>
                                    <div class="nk-int-st">
                                        <label>Kategori Icon (Class)</label>
                                        <input type="text" asp-for="CategoryIconUrl" id="icon-input" class="form-control" placeholder="Örn: fa fa-heart">
                                    </div>
                                    <span asp-validation-for="CategoryIconUrl" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mg-t-15">
                                <button type="submit" class="btn btn-success btn-icon-notika">
                                    <i class="fa fa-save"></i> Bilgileri Güncelle
                                </button>
                                <a href="/Category/CategoryList" class="btn btn-danger btn-icon-notika">
                                    <i class="fa fa-arrow-left"></i> Vazgeç
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Sayfa yenilenmeden ikonun değiştiğini görmek için küçük bir script *@
    <script>
        $("#icon-input").on("input", function () {
            $("#icon-preview").attr("class", $(this).val());
        });
    </script>
}

<style>
    .text-danger {
        color: #ff0000 !important;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }

    .mg-t-15 {
        margin-top: 15px;
    }
</style>