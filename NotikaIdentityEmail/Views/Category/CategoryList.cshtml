@model List<CategoryListDto>

@{
    ViewData["Title"] = "CategoryList";
    Layout = "~/Views/UserLayout/Index.cshtml";
    int count = 0;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<style>
    .status-badge {
        border: none;
        cursor: pointer;
        padding: 6px 12px;
        border-radius: 4px;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .status-badge:hover {
            opacity: 0.8;
            transform: scale(1.05);
        }
</style>

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">

                    <div class="basic-tb-hd">
                        <h2><i class="fa fa-tags"></i> Kategori Listesi</h2>
                        <p>Sistemde tanımlı olan kategorileri yönetebilir, durumlarını anlık olarak değiştirebilirsiniz.</p>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Kategori Adı</th>
                                    <th>Icon</th>
                                    <th class="text-center">Durum (Tıkla Değiştir)</th>
                                    <th style="width: 250px;" class="text-center">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td><strong>@count</strong></td>
                                        <td>@item.CategoryName</td>
                                        <td><i class="@item.CategoryIconUrl"></i></td>
                                        <td class="text-center">
                                            @if (item.CategoryStatus ?? false)
                                            {
                                                <button class="status-badge btn-change-status"
                                                        style="background-color: #28a745;"
                                                        data-id="@item.Id"
                                                        data-status="true">
                                                    <i class="fa fa-check-circle"></i> Aktif
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="status-badge btn-change-status"
                                                        style="background-color: #dc3545;"
                                                        data-id="@item.Id"
                                                        data-status="false">
                                                    <i class="fa fa-times-circle"></i> Pasif
                                                </button>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a href="/Category/EditCategory/@item.Id" class="btn btn-sm btn-info">
                                                <i class="fa fa-edit"></i> Güncelle
                                            </a>
                                            <button class="btn btn-danger btn-sm btn-delete"
                                                    data-id="@item.Id"
                                                    data-name="@item.CategoryName">
                                                <i class="fa fa-trash"></i> Sil
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="form-example-int mg-t-15">
                        <a href="/Category/CreateCategory" class="btn btn-primary">
                            <i class="fa fa-plus"></i> Yeni Kategori Oluştur
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {

            // 1. DURUM DEĞİŞTİRME (TOGGLE STATUS)
            $(document).on("click", ".btn-change-status", function () {
                const button = $(this);
                const categoryId = button.data("id");
                const currentStatus = button.data("status");
                const newStatus = !currentStatus;

                $.ajax({
                    type: "POST",
                    url: "/Category/ChangeStatus/",
                    data: { id: categoryId, status: newStatus },
                    success: function (response) {
                        if (response.success) {
                            if (newStatus) {
                                button.css("background-color", "#28a745")
                                      .data("status", true)
                                      .html('<i class="fa fa-check-circle"></i> Aktif');
                            } else {
                                button.css("background-color", "#dc3545")
                                      .data("status", false)
                                      .html('<i class="fa fa-times-circle"></i> Pasif');
                            }

                            // Sağ üstte küçük bildirim
                            const Toast = Swal.mixin({
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 1500
                            });
                            Toast.fire({ icon: 'success', title: 'Durum güncellendi' });
                        } else {
                            Swal.fire('Hata!', 'İşlem başarısız oldu.', 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Hata!', 'Sunucuyla bağlantı kesildi.', 'error');
                    }
                });
            });

            // 2. SİLME İŞLEMİ (DELETE)
            $(document).on("click", ".btn-delete", function () {
                const categoryId = $(this).data("id");
                const categoryName = $(this).data("name");
                const currentRow = $(this).closest("tr");

                Swal.fire({
                    title: 'Emin misiniz?',
                    text: `"${categoryName}" kategorisi silinecektir!`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'Vazgeç',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            type: "POST",
                            url: "/Category/DeleteCategory/",
                            data: { id: categoryId },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire({
                                        title: 'Silindi!',
                                        text: response.message,
                                        icon: 'success',
                                        timer: 1500,
                                        showConfirmButton: false
                                    });
                                    currentRow.fadeOut(600, function() { $(this).remove(); });
                                } else {
                                    Swal.fire('Hata!', response.message, 'error');
                                }
                            }
                        });
                    }
                });
            });
        });
    </script>
}