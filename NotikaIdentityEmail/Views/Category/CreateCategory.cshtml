@model ComposeCategoryDto

@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Kategori Ekleme Sayfası</h2>
                        <p>Lütfen kategori bilgilerini eksiksiz olarak doldurunuz.</p>
                    </div>


                    <div asp-validation-summary="ModelOnly" class="text-danger m-b-20"></div>

                    <form asp-action="CreateCategory" asp-controller="Category" method="post">

                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label> Kategori Adı</label>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="CategoryName" class="form-control" placeholder="Kategori Adı...">
                                    </div>
                                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Kategori Icon Url</label>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="CategoryIconUrl" class="form-control" placeholder="Kategori Icon Url...">
                                    </div>
                                    <span asp-validation-for="CategoryIconUrl" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <button type="submit" class="btn btn-success">Kategoriyi Oluştur </button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-danger {
        color: #ff0000 !important;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }
</style>
