@using Entity_Layer.DTOs.AppRoleDtos
@model List<RoleListDto>

@{
	ViewData["Title"] = "RoleList";
	Layout = "~/Views/UserLayout/Index.cshtml";
	int count = 0;
}

<div class="form-element-area">
	<div class="container">
		<div class="row">
			<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
				<div class="form-element-list">
					<div class="basic-tb-hd">
						<h2>Rol Listesi</h2>
						<p>Tüm roller ve açıklamaları aşağıda listelenmektedir.</p>
					</div>

					<div class="row">

						<table class="table table-bordered">
							<tr>
								<th>#</th>
								<th>Rol Adı</th>
								<th>Rol Açıklaması</th>
								<th>Rolü Güncelle</th>
								<th>Rolü Sil</th>
							</tr>


							@foreach (var item in Model)
							{
								count++;
								<tr>
									<td>@count</td>
									<td>@item.RoleName</td>
									<td>@item.Description</td>
									<td>
										<a href="/Role/UpdateRole/@item.Id" class="btn btn-success">Güncelle</a>
									</td>
									<td>
										<a href="/Role/DeleteRole/@item.Id" class="btn btn-danger">Sil</a>
									</td>
								</tr>
							}
						</table>

						<a href="/Role/CreateRole" class="btn btn-primary">Rol Oluştur</a>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>

