@model MessageDetailDto
@using Business_Layer.Helpers

@{
	ViewData["Title"] = "MessageDetails";
	Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="inbox-area">
	<div class="container">
		<div class="row">

			@await Component.InvokeAsync("_MessageSidebarComponentPartial")

			<div class="col-lg-9 col-md-9 col-sm-9 col-xs-12">
				<div class="view-mail-list sm-res-mg-t-30">
					<div class="view-mail-hd">
						<div class="view-mail-hrd">
							<h2>Mesaj Detayları</h2>
						</div>
						<div class="view-ml-rl">
							<p>
								<strong>Gönderim Saati:</strong> @Model.SendDate.ToString("HH:mm")
								<span class="text-muted">(@DateHelper.GetTimeAgo(Model.SendDate))</span>
							</p>
						</div>
					</div>
					<div class="mail-ads mail-vw-ph">
						<p class="first-ph"><b>Konu: </b>@Model.Subject</p>
						<p><b>Gönderen Kişi:</b> <a href="#">@Model.SenderName</a></p>
						<p><b>Alıcı Kişi:</b> <a href="#">@Model.ReceiverName</a></p>
						<p class="last-ph"><b>Tarih:</b> @Model.SendDate.ToString("dd MMM yyyy")</p>
					</div>
					<div class="view-mail-atn message-content-container">
						<p>@Html.Raw(Model.MessageDetail)</p> @* Html.Raw ifadesiSQLden çekerken html ifadesi nasıl o formatta çekmeye yarar.  *@
					</div>

					<div class="vw-ml-action-ls text-right mg-t-20">
						<div class="btn-group ib-btn-gp active-hook nk-email-inbox">
							<button class="btn btn-default btn-sm waves-effect"><i class="notika-icon notika-next"></i> Yanıtla</button>
							<button class="btn btn-default btn-sm waves-effect"><i class="notika-icon notika-right-arrow"></i> İlet</button>
							<button class="btn btn-default btn-sm waves-effect"><i class="notika-icon notika-print"></i> Yazdır</button>
							<button class="btn btn-default btn-sm waves-effect" id="btnDeleteMessageDetail" data-id="@Model.Id">
								<i class="notika-icon notika-trash"></i> Sil
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	/* Mesaj içeriğindeki tüm etiketlerin blok olmasını engelle */
	.message-content-container * {
		display: inline; /* Tüm etiketleri yan yana akmaya zorlar */
		margin: 0;
		padding: 0;
	}

	/* Paragraflar ve satır başları için istisna tanı */
	.message-content-container p,
	.message-content-container div,
	.message-content-container br {
		display: block; /* Sadece gerçek paragraflar ve satır başları alt satıra geçsin */
		margin-bottom: 10px;
	}

	/* Summernote'tan gelen listelerin bozulmaması için */
	.message-content-container ul,
	.message-content-container ol {
		display: block;
		padding-left: 20px;
	}

	.message-content-container li {
		display: list-item;
	}

	/* Bold ve Italic gibi vurguların yanındaki metni itmesini engelle */
	.message-content-container strong,
	.message-content-container b,
	.message-content-container span,
	.message-content-container i,
	.message-content-container u {
		display: inline !important;
		white-space: normal;
	}
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
	document.getElementById('btnDeleteMessageDetail').addEventListener('click', function () {
		var messageId = this.getAttribute('data-id');

		Swal.fire({
			title: 'Emin misiniz?',
			text: "Bu mesaj çöp kutusuna taşınacak!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Evet, sil!',
			cancelButtonText: 'Vazgeç',
			background: '#fff'
		}).then((result) => {
			if (result.isConfirmed) {
				// AJAX ile silme isteği gönderiyoruz
				$.ajax({
					url: '/Message/DeleteMessageAjax/',
					type: 'POST',
					data: { id: messageId },
					success: function (response) {
						if (response.success) {
							Swal.fire({
								title: 'Silindi!',
								text: 'Mesaj başarıyla çöp kutusuna taşındı.',
								icon: 'success',
								timer: 1500,
								showConfirmButton: false
							}).then(() => {
								// Silme başarılıysa Gelen Kutusu'na yönlendir
								window.location.href = '/Message/Inbox';
							});
						} else {
							Swal.fire('Hata!', 'Mesaj silinirken bir sorun oluştu.', 'error');
						}
					},
					error: function () {
						Swal.fire('Teknik Hata!', 'Sunucuyla bağlantı kurulamadı.', 'error');
					}
				});
			}
		});
	});
</script>

