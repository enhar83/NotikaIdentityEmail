@model List<MessageListInHeaderDto>

<div role="menu" class="dropdown-menu message-dd animated zoomIn">
	<div class="hd-mg-tt">
		<h2>Okunmamış Son Mesajlar</h2>
	</div>
	@if (Model != null && Model.Any())
	{
		@foreach (var item in Model)
		{
			<div class="hd-message-info">
				<a href="/Message/MessageDetails/@item.Id">
					<div class="hd-message-sn">
						<div class="hd-message-img">
							<img src="@item.SenderImageUrl" class="header-msg-img" alt="@item.SenderName" />
						</div>
						<div class="hd-mg-ctn">
							<h3>@item.SenderName</h3>
							<p>
								@{
									var plainText = System.Text.RegularExpressions.Regex.Replace(item.MessageDetail ?? "", "<.*?>", string.Empty);
									var displayText = plainText.Length > 40 ? plainText.Substring(0, 37) + "..." : plainText;
								}
								@displayText
							</p>
						</div>
					</div>
				</a>
			</div>
		}
	}
	else
	{
		<div class="text-center p-3">
			<span style="font-size: 13px; color: #999;">Yeni mesajınız bulunmuyor.</span>
		</div>
	}

	<div class="hd-mg-va">
		<a href="/Message/Inbox">Hepsini Gör</a>
	</div>
</div>

<style>
	/* Mesaj resimlerini sabitleyen CSS */
	.header-msg-img {
		width: 40px !important; /* Genişliği sabitle */
		height: 40px !important; /* Yüksekliği sabitle */
		object-fit: cover; /* Resmi bozmadan alanı doldurur */
		border-radius: 50%; /* Tam daire yapar */
	}

	/* Eğer resimlerin yanındaki alanın genişliği de farklıysa burayı da sabitleyebiliriz */
	.hd-message-img {
		width: 40px;
		height: 40px;
		flex-shrink: 0; /* Resmin küçülmesini engeller */
	}
</style>