@model List<MessageListByCategoryDto>
@using Business_Layer.Helpers

<div class="table-responsive">
    <table class="table table-hover table-inbox">
        <thead>
            <tr>
                <th>#</th>
                <th>Gönderen Kişi</th>
                <th>Kategori</th>
                <th>Mesaj Konusu</th>
                <th>Tarih</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsRead ? "" : "unread")">
                        @* 1. Sütun: Okunma Durumu İkonu *@
                        <td style="width: 40px; vertical-align: middle; text-align: center;">
                            @if (item.IsRead)
                            {
                                <i class="notika-icon notika-checked" style="color: #00c292;"></i>
                            }
                            else
                            {
                                <i class="notika-icon notika-mail" style="color: #ccc;"></i>
                            }
                        </td>

                        @* 2. Sütun: Gönderici *@
                        <td style="width: 200px; vertical-align: middle;">
                            <a href="/Message/MessageDetails/@item.Id" style="color: inherit;">
                                @item.SenderName
                            </a>
                        </td>

                        @* 3. Sütun: Kategori *@
                        <td style="width: 110px; vertical-align: middle;">
                            <span class="label @CategoryColorHelperForInboxAndSendbox.GetLabelClass(item.CategoryName)">
                                @item.CategoryName
                            </span>
                        </td>

                        @* 4. Sütun: Mesaj Konusu (Görünme Sorunu Düzeltildi) *@
                        <td style="vertical-align: middle;">
                            <a href="/Message/MessageDetails/@item.Id" style="color: inherit; text-decoration: none; display: block; min-width: 200px;">
                                <div class="truncate-text" title="@item.Subject">
                                    @(!string.IsNullOrEmpty(item.Subject) ? item.Subject : "Konu Belirtilmemiş")
                                </div>
                            </a>
                        </td>

                        @* 5. Sütun: Tarih *@
                        <td class="text-right mail-date" style="width:120px; vertical-align: middle;">
                            @item.SendDate.ToString("dd MMM yyyy")
                        </td>

                        @* 6. Sütun: İşlem Butonu *@
                        <td class="text-right" style="width:150px; vertical-align: middle;">
                            <a href="/Message/MessageDetails/@item.Id" class="btn btn-sm btn-info">
                                Mesaj İçeriği
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center" style="padding: 20px;">
                        Bu kategoride mesaj bulunamadı.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    /* Konunun uzun gelmesi durumunda tabloyu bozmaması için sınırlama */
    .truncate-text {
        display: block;
        max-width: 350px; /* Genişliği biraz artırdık */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4;
    }

    .table-inbox td {
        white-space: nowrap;
        border-top: 1px solid #f0f0f0;
    }

    /* Okunmamış (unread) mesajlar için kalınlık vurgusu */
    tr.unread td, tr.unread td a, tr.unread td div {
        font-weight: bold !important;
        color: #333;
    }

    /* Okunmamış satıra hafif bir arka plan rengi */
    tr.unread {
        background-color: #fbfbfb;
    }
</style>

<script>
    // Geri butonuyla dönüldüğünde listenin "okunmuş" olarak güncellenmesi için
    window.addEventListener('pageshow', function (event) {
        var historyTraversal = event.persisted ||
                               (typeof window.performance != 'undefined' &&
                                window.performance.navigation.type === 2);
        if (historyTraversal) {
            window.location.reload();
        }
    });
</script>