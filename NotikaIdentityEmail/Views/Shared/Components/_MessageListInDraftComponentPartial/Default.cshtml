@model List<Entity_Layer.DTOs.MessageDtos.MessageListDraftDto>
@using Business_Layer.Helpers

<div class="table-responsive">
    <table class="table table-hover table-inbox">
        <thead>
            <tr>
                <th>Alıcı Kişi</th>
                <th>Kategori</th>
                <th>Mesaj Konusu</th>
                <th>Tarih</th>
                <th class="text-right">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        @* 1. Sütun: Alıcı Adı *@
                        <td style="width: 200px; vertical-align: middle;">
                            @if (!string.IsNullOrEmpty(item.ReceiverName))
                            {
                                <a href="/Message/ComposeMessage/@item.Id">@item.ReceiverName</a>
                            }
                            else
                            {
                                <span class="text-muted"><em><i class="fa fa-user-secret"></i> Alıcı Belirlenmedi</em></span>
                            }
                        </td>

                        @* 2. Sütun: Kategori *@
                        <td style="width: 110px; vertical-align: middle;">
                            @if (!string.IsNullOrEmpty(item.CategoryName))
                            {
                                <span class="label @CategoryColorHelperForInboxAndSendbox.GetLabelClass(item.CategoryName)">
                                    @item.CategoryName
                                </span>
                            }
                            else
                            {
                                <span class="label label-default" style="background-color: #d1d1d1;">Belirtilmedi</span>
                            }
                        </td>

                        @* 3. Sütun: Mesaj Konusu *@
                        <td style="vertical-align: middle;">
                            <a href="/Message/ComposeMessage/@item.Id" class="subject-link">
                                <strong class="truncate-text" title="@(string.IsNullOrEmpty(item.Subject) ? "Konu Yok" : item.Subject)">
                                    @if (!string.IsNullOrEmpty(item.Subject))
                                    {
                                        @item.Subject
                                    }
                                    else
                                    {
                                        <span class="text-warning">(Konu Belirtilmedi)</span>
                                    }
                                </strong>
                            </a>
                        </td>

                        @* 4. Sütun: Tarih *@
                        <td class="text-right mail-date" style="width: 120px; vertical-align: middle;">
                            @item.SendDate.ToString("dd MMM yyyy")
                        </td>

                        @* 5. Sütun: Düzenle/Tamamla Butonu *@
                        <td class="text-right" style="width: 150px; vertical-align: middle;">
                            <a href="/Message/ComposeMessage/@item.Id" class="btn btn-sm btn-warning">
                                <i class="fa fa-edit"></i> Taslağı Tamamla
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">Kayıtlı taslağınız bulunmamaktadır.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .truncate-text {
        display: block;
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4;
    }

    .table-inbox td {
        white-space: nowrap;
    }

    /* Boş alanlar için italik ve soluk renkli stil */
    .text-muted em {
        font-size: 0.9em;
        color: #999;
    }
</style>