@model List<Entity_Layer.DTOs.MessageDtos.MessageListDraftDto>
@using Business_Layer.Helpers

<div class="table-responsive">
    <table class="table table-hover table-inbox">
        <thead>
            <tr>
                <th>Alıcı Kişi</th>
                <th>Kategori</th>
                <th>Mesaj Konusu</th>
                <th>Tarih</th>
                <th class="text-center" style="width: 200px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        @* 1. Sütun: Alıcı Adı *@
                        <td style="width: 200px; vertical-align: middle;">
                            @if (!string.IsNullOrEmpty(item.ReceiverName))
                            {
                                <a href="/Message/ComposeMessage/@item.Id">@item.ReceiverName</a>
                            }
                            else
                            {
                                <span class="text-muted"><em><i class="fa fa-user-secret"></i> Alıcı Belirlenmedi</em></span>
                            }
                        </td>

                        @* 2. Sütun: Kategori *@
                        <td style="width: 110px; vertical-align: middle;">
                            @if (!string.IsNullOrEmpty(item.CategoryName))
                            {
                                <span class="label @CategoryColorHelperForInboxAndSendbox.GetLabelClass(item.CategoryName)">
                                    @item.CategoryName
                                </span>
                            }
                            else
                            {
                                <span class="label label-default" style="background-color: #d1d1d1;">Belirtilmedi</span>
                            }
                        </td>

                        @* 3. Sütun: Mesaj Konusu *@
                        <td style="vertical-align: middle;">
                            <a href="/Message/ComposeMessage/@item.Id" class="subject-link">
                                <strong class="truncate-text" title="@(string.IsNullOrEmpty(item.Subject) ? "Konu Yok" : item.Subject)">
                                    @if (!string.IsNullOrEmpty(item.Subject))
                                    {
                                        @item.Subject
                                    }
                                    else
                                    {
                                        <span class="text-warning">(Konu Belirtilmedi)</span>
                                    }
                                </strong>
                            </a>
                        </td>

                        @* 4. Sütun: Tarih *@
                        <td class="text-right mail-date" style="width: 120px; vertical-align: middle;">
                            @item.SendDate.ToString("dd MMM yyyy")
                        </td>

                        <td class="text-center" style="width: 150px; vertical-align: middle;">
                            <div class="btn-group-custom">
                                <a href="@(ViewContext.RouteData.Values["action"]?.ToString() == "Draft" ? "/Message/ComposeMessage/" : "/Message/MessageDetails/")@item.Id"
                                   class="btn btn-info btn-xs btn-custom" title="Görüntüle">
                                    <i class="notika-icon notika-edit"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-danger btn-xs btn-custom delete-message-btn"
                                        data-id="@item.Id"
                                        title="Sil">
                                    <i class="notika-icon notika-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">Kayıtlı taslağınız bulunmamaktadır.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .truncate-text {
        display: block;
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4;
    }

    .table-inbox td {
        white-space: nowrap;
    }

    /* Boş alanlar için italik ve soluk renkli stil */
    .text-muted em {
        font-size: 0.9em;
        color: #999;
    }

    .btn-group-custom {
        display: flex;
        justify-content: center;
        gap: 8px; /* Butonlar arası boşluk */
    }

    .btn-custom {
        border-radius: 4px !important; /* Köşeleri yuvarla */
        padding: 5px 10px !important;
        transition: all 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px); /* Üzerine gelince hafif yükselme efekti */
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).on('click', '.delete-message-btn', function (e) {
        e.preventDefault();
        var btn = $(this);
        var messageId = btn.data('id');
        var row = btn.closest('tr');

        Swal.fire({
            title: 'Emin misiniz?',
            text: "Mesaj çöp kutusuna taşınacak!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'Vazgeç',
            background: '#fff',
            customClass: {
                popup: 'animated fadeInDown'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Message/DeleteMessageAjax/',
                    type: 'POST',
                    data: { id: messageId },
                    success: function (response) {
                        if (response.success) {
                            row.fadeOut(400, function () { $(this).remove(); });
                            Swal.fire(
                                'Silindi!',
                                'Mesaj başarıyla taşındı.',
                                'success'
                            );
                        } else {
                            Swal.fire('Hata!', 'Bir sorun oluştu.', 'error');
                        }
                    }
                });
            }
        });
    });

    // Geri butonuyla dönüldüğünde sayfayı yenileme (Daha önce konuştuğumuz mantık)
    window.addEventListener('pageshow', function (event) {
        if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
            window.location.reload();
        }
    });
</script>