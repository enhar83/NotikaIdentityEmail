@model List<MessageListInboxDto>
@using Business_Layer.Helpers

<div class="table-responsive">
    <table class="table table-hover table-inbox">
        <thead>
            <tr>
                <th>#</th>
                <th>Gönderen Kişi</th>
                <th>Kategori</th>
                <th>Mesaj Konusu</th>
                <th>Tarih</th>
                <th class="text-center" style="width: 200px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsRead ? "" : "unread")">
                        @* 1. Sütun: Durum İkonu *@
                        <td style="width: 40px; vertical-align: middle; text-align: center;">
                            @if (item.IsRead)
                            {
                                <i class="notika-icon notika-checked" style="color: #00c292;"></i>
                            }
                            else
                            {
                                <i class="notika-icon notika-mail" style="color: #ccc;"></i>
                            }
                        </td>

                        @* 2. Sütun: Gönderici *@
                        <td style="width: 200px; vertical-align: middle;">
                            <a href="/Message/MessageDetails/@item.Id" style="color: inherit;">
                                @item.SenderName
                            </a>
                        </td>

                        @* 3. Sütun: Kategori *@
                        <td style="width: 110px; vertical-align: middle;">
                            <span class="label @CategoryColorHelperForInboxAndSendbox.GetLabelClass(item.CategoryName)">
                                @item.CategoryName
                            </span>
                        </td>

                        @* 4. Sütun: Mesaj Konusu (Düzenlendi) *@
                        <td style="vertical-align: middle;">
                            <a href="/Message/MessageDetails/@item.Id" class="subject-link" style="color: inherit; text-decoration: none;">
                                @* Truncate class'ını doğrudan a etiketine veya içteki metne veriyoruz *@
                                <div class="truncate-text" title="@item.Subject">
                                    @(!string.IsNullOrEmpty(item.Subject) ? item.Subject : "Konu Belirtilmemiş")
                                </div>
                            </a>
                        </td>

                        @* 5. Sütun: Tarih *@
                        <td class="text-right mail-date" style="width:120px; vertical-align: middle;">
                            @item.SendDate.ToString("dd MMM yyyy")
                        </td>

                        <td class="text-center" style="width: 150px; vertical-align: middle;">
                            <div class="btn-group-custom">
                                <a href="@(ViewContext.RouteData.Values["action"]?.ToString() == "Draft" ? "/Message/ComposeMessage/" : "/Message/MessageDetails/")@item.Id"
                                   class="btn btn-info btn-xs btn-custom" title="Görüntüle">
                                    <i class="notika-icon notika-edit"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-danger btn-xs btn-custom delete-message-btn"
                                        data-id="@item.Id"
                                        title="Sil">
                                    <i class="notika-icon notika-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center" style="padding: 20px;">Gelen mesaj bulunamadı.</td></tr>
            }
        </tbody>
    </table>
</div>

<style>
    .truncate-text {
        /* display: block yerine inline-block veya table-cell denenebilir ama block kalsın, max-width ekleyelim */
        display: block;
        max-width: 350px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4;
    }

    .table-inbox td {
        white-space: nowrap;
        border-top: 1px solid #f0f0f0;
    }

    /* Okunmamış satırları kalın yapıyoruz */
    tr.unread td, tr.unread td a, tr.unread td div {
        font-weight: bold !important;
        color: #333;
    }

    tr.unread {
        background-color: #fbfbfb;
    }

    .btn-group-custom {
        display: flex;
        justify-content: center;
        gap: 8px; /* Butonlar arası boşluk */
    }

    .btn-custom {
        border-radius: 4px !important; /* Köşeleri yuvarla */
        padding: 5px 10px !important;
        transition: all 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px); /* Üzerine gelince hafif yükselme efekti */
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
</style>

<script>
    window.addEventListener('pageshow', function (event) {
        if (event.persisted || (typeof window.performance != 'undefined' && window.performance.navigation.type === 2)) {
            window.location.reload();
        }
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).on('click', '.delete-message-btn', function (e) {
        e.preventDefault();
        var btn = $(this);
        var messageId = btn.data('id');
        var row = btn.closest('tr');

        Swal.fire({
            title: 'Emin misiniz?',
            text: "Mesaj çöp kutusuna taşınacak!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'Vazgeç',
            background: '#fff',
            customClass: {
                popup: 'animated fadeInDown'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    // URL TOGGLE METODUNA GÜNCELLENDİ
                    url: '/Message/ChangeMessageDeleteStatusAjax/',
                    type: 'POST',
                    data: { id: messageId },
                    success: function (response) {
                        if (response.success) {
                            // Satırı listeden kaldır
                            row.fadeOut(400, function () { $(this).remove(); });

                            Swal.fire({
                                title: 'Başarılı!',
                                text: 'Mesaj çöp kutusuna taşındı.',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire('Hata!', response.message || 'Bir sorun oluştu.', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Hata!', 'Sunucuyla bağlantı kurulamadı.', 'error');
                    }
                });
            }
        });
    });

    // Geri butonuyla dönüldüğünde sayfayı yenileme (Daha önce konuştuğumuz mantık)
    window.addEventListener('pageshow', function (event) {
        if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
            window.location.reload();
        }
    });
</script>