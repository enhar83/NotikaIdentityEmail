<div class="header-top-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                <div class="logo-area">
                    <a href="#"><img src="/notika-master/notika/green-horizotal/img/logo/logo.png" alt="" /></a>
                </div>
            </div>
            <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
                <div class="header-top-menu">
                    <ul class="nav navbar-nav notika-top-nav">
                        <li class="nav-item dropdown">
                            <a href="#" data-toggle="dropdown" role="button" aria-expanded="false" class="nav-link dropdown-toggle"><span><i class="notika-icon notika-search"></i></span></a>
                            <div role="menu" class="dropdown-menu search-dd animated flipInX">
                                <div class="search-input">
                                    <i class="notika-icon notika-left-arrow"></i>
                                    <input type="text" />
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a href="#" data-toggle="dropdown" role="button" aria-expanded="false" class="nav-link dropdown-toggle"><span><i class="notika-icon notika-mail"></i></span></a>
                            
                            @await Component.InvokeAsync("_MessageListOnNavbarHeaderComponentPartial")
                            
                        </li>
                        <li class="nav-item nc-al">
                            
                            @await Component.InvokeAsync("_UnreadMessageCountForNavbarHeaderPartial")

                            @await Component.InvokeAsync("_NotificationListOnNavbarHeaderComponentPartial")

                        </li>
                        <li class="nav-item">

                            @await Component.InvokeAsync("_UnreadNotificationCountForNavbarHeaderPartial")
                            
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>