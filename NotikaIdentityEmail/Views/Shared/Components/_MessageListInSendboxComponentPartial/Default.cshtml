@model List<Entity_Layer.DTOs.MessageDtos.MessageListSendboxDto>
@using Business_Layer.Helpers

<div class="table-responsive">
    <table class="table table-hover table-inbox">

        <tr>
            <th>Alıcı Kişi</th>
            <th>Kategori</th>
            <th>Mesaj Konusu</th>
            <th>Tarih</th>
            <th class="text-center" style="width: 200px;">İşlemler</th>
        </tr>

        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        @* 2. Sütun: Alıcı Adı (Sendbox olduğu için ReceiverName kullanıldı) *@
                        <td style="width: 200px; vertical-align: middle;">
                            <a href="/Message/MessageDetails/@item.Id">@item.ReceiverName</a>
                        </td>

                        @* 3. Sütun: Kategori *@
                        <td style="width: 110px; vertical-align: middle;">
                            <span class="label @CategoryColorHelperForInboxAndSendbox.GetLabelClass(item.CategoryName)">
                                @item.CategoryName
                            </span>
                        </td>

                        @* 4. Sütun: Mesaj Konusu *@
                        <td style="vertical-align: middle;">
                            <a href="/Message/MessageDetails/@item.Id" class="subject-link">
                                <strong class="truncate-text" title="@item.Subject">@item.Subject</strong>
                            </a>
                        </td>

                        @* 5. Sütun: Tarih *@
                        <td class="text-right mail-date" style="width: 120px; vertical-align: middle;">
                            @item.SendDate.ToString("dd MMM yyyy")
                        </td>

                        <td class="text-center" style="width: 150px; vertical-align: middle;">
                            <div class="btn-group-custom">
                                <a href="@(ViewContext.RouteData.Values["action"]?.ToString() == "Draft" ? "/Message/ComposeMessage/" : "/Message/MessageDetails/")@item.Id"
                                   class="btn btn-info btn-xs btn-custom" title="Görüntüle">
                                    <i class="notika-icon notika-edit"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-danger btn-xs btn-custom delete-message-btn"
                                        data-id="@item.Id"
                                        title="Sil">
                                    <i class="notika-icon notika-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">Gönderilmiş mesaj bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .truncate-text {
        display: block;
        max-width: 250px; /* Burayı ekranındaki boşluğa göre 200px veya 300px yapabilirsin */
        white-space: nowrap; /* Kelimelerin alt satıra geçmesini engeller (Üst üste binme biter) */
        overflow: hidden; /* Sığmayan kısmı gizler */
        text-overflow: ellipsis; /* Gizlenen yerin sonuna ... koyar */
        line-height: 1.4; /* Harflerin birbirine girmemesi için dikey boşluk */
    }

    /* Tablonun diğer sütunlarının kaymaması için */
    .table-inbox td {
        white-space: nowrap;
    }

    .btn-group-custom {
        display: flex;
        justify-content: center;
        gap: 8px; /* Butonlar arası boşluk */
    }

    .btn-custom {
        border-radius: 4px !important; /* Köşeleri yuvarla */
        padding: 5px 10px !important;
        transition: all 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px); /* Üzerine gelince hafif yükselme efekti */
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).on('click', '.delete-message-btn', function (e) {
        e.preventDefault();
        var btn = $(this);
        var messageId = btn.data('id');
        var row = btn.closest('tr');

        Swal.fire({
            title: 'Emin misiniz?',
            text: "Mesaj çöp kutusuna taşınacak!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'Vazgeç',
            background: '#fff',
            customClass: {
                popup: 'animated fadeInDown'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Message/ChangeMessageDeleteStatusAjax/',
                    type: 'POST',
                    data: { id: messageId },
                    success: function (response) {
                        if (response.success) {
                            // 1. Önce satırı görsel olarak kaldırıyoruz
                            row.fadeOut(400, function () { $(this).remove(); });

                            // 2. Başarı mesajını gösteriyoruz
                            Swal.fire({
                                title: 'Başarılı!',
                                text: 'Mesaj çöp kutusuna taşındı.',
                                icon: 'success',
                                timer: 1000, // 1 saniye sonra otomatik kapanır
                                showConfirmButton: false
                            }).then(() => {
                                // 3. MESAJ KAPANDIĞINDA SAYFAYI YENİLE
                                // Bu sayede Sidebar'daki sayılar güncellenir.
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Hata!', response.message || 'Bir sorun oluştu.', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Hata!', 'Sunucuyla bağlantı kurulamadı.', 'error');
                    }
                });
            }
        });
    });

    // Geri butonuyla dönüldüğünde sayfayı yenileme
    window.addEventListener('pageshow', function (event) {
        if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
            window.location.reload();
        }
    });
</script>