@using Entity_Layer.DTOs.AppUserDtos.ProfileDtos
@model EditProfileDto

@{
    ViewData["Title"] = "Profil Düzenleme";
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2><i class="notika-icon notika-edit"></i> Profil Düzenleme</h2>
                        <p>Lütfen bilgilerinizi eksiksiz olarak doldurup güncelleme işlemini yapınız.</p>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger m-b-20"></div>

                    <form asp-action="EditProfile" asp-controller="Profile" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group ic-cmp-int">
                                            <div class="form-ic-cmp"><i class="notika-icon notika-support"></i></div>
                                            <div class="nk-int-st">
                                                <label class="small text-muted">Adınız</label>
                                                <input type="text" asp-for="Name" class="form-control" placeholder="Adınız">
                                                <span asp-validation-for="Name" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group ic-cmp-int">
                                            <div class="form-ic-cmp"><i class="notika-icon notika-support"></i></div>
                                            <div class="nk-int-st">
                                                <label class="small text-muted">Soyadınız</label>
                                                <input type="text" asp-for="Surname" class="form-control" placeholder="Soyadınız">
                                                <span asp-validation-for="Surname" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row" style="margin-top: 15px;">
                                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group ic-cmp-int">
                                            <div class="form-ic-cmp"><i class="notika-icon notika-map"></i></div>
                                            <div class="nk-int-st">
                                                <label class="small text-muted">Şehriniz</label>
                                                <input type="text" asp-for="City" class="form-control" placeholder="Şehiriniz">
                                                <span asp-validation-for="City" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group ic-cmp-int">
                                            <div class="form-ic-cmp"><i class="notika-icon notika-phone"></i></div>
                                            <div class="nk-int-st">
                                                <label class="small text-muted">Telefon Numaranız</label>
                                                <input type="text" asp-for="PhoneNumber" class="form-control" placeholder="Telefon Numaranız">
                                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row" style="margin-top: 15px;">
                                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group ic-cmp-int">
                                            <div class="form-ic-cmp"><i class="notika-icon notika-user"></i></div>
                                            <div class="nk-int-st">
                                                <label class="small text-muted">Kullanıcı Adınız</label>
                                                <input type="text" asp-for="UserName" class="form-control" placeholder="Kullanıcı Adınız">
                                                <span asp-validation-for="UserName" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                        <div class="form-group ic-cmp-int">
                                            <div class="form-ic-cmp"><i class="notika-icon notika-mail"></i></div>
                                            <div class="nk-int-st">
                                                <label class="small text-muted">Email Adresiniz</label>
                                                <input type="email" asp-for="Email" class="form-control" placeholder="Email Adresiniz">
                                                <span asp-validation-for="Email" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row" style="margin-top: 15px;">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="form-group ic-cmp-int">
                                            <div class="form-ic-cmp"><i class="notika-icon notika-picture"></i></div>
                                            <div class="nk-int-st">
                                                <label class="small text-muted">Fotoğraf URL</label>
                                                <input type="text" id="imageUrlInput" asp-for="ImageUrl" class="form-control" placeholder="Fotoğraf Url'sini yapıştırın">
                                                <span asp-validation-for="ImageUrl" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="preview-card">
                                    <h4 class="text-center">Görünüm Önizleme</h4>
                                    <hr />
                                    <div class="text-center">
                                        <img id="profilePreview"
                                             src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/default-user.png" : Model.ImageUrl)"
                                             alt="Önizleme"
                                             class="img-circle profile-preview-img shadow">
                                        <h5 id="namePreview" style="margin-top: 15px;">@Model.Name @Model.Surname</h5>
                                        <p id="usernamePreview" class="text-muted">@@@Model.UserName</p>
                                    </div>
                                    <div class="preview-footer text-center" style="margin-top: 20px;">
                                        <button type="submit" class="btn btn-success btn-lg btn-block waves-effect">
                                            <i class="notika-icon notika-checked"></i> Değişiklikleri Kaydet
                                        </button>
                                        <a href="/Profile/Index" class="btn btn-default btn-block m-t-10">Vazgeç</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-ic-cmp {
        color: #00c292;
        font-size: 20px;
    }

    .preview-card {
        background: #f9f9f9;
        border: 1px dashed #ddd;
        border-radius: 10px;
        padding: 20px;
        position: sticky;
        top: 20px;
    }

    .profile-preview-img {
        width: 140px;
        height: 140px;
        object-fit: cover;
        border: 5px solid #fff;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .text-danger {
        color: #ff0000 !important;
        font-size: 11px;
        margin-top: 4px;
        display: block;
    }

    .nk-int-st label {
        margin-bottom: 2px;
        font-weight: 500;
    }

    .btn-success {
        background-color: #00c292;
        border: none;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const urlInput = document.getElementById('imageUrlInput');
        const previewImg = document.getElementById('profilePreview');
        const nameInput = document.querySelector('input[name="Name"]');
        const surnameInput = document.querySelector('input[name="Surname"]');
        const usernameInput = document.querySelector('input[name="UserName"]');

        // Fotoğraf Önizleme
        if (urlInput) {
            urlInput.addEventListener('input', function() {
                previewImg.src = this.value || "/img/default-user.png";
            });
        }

        // Hatalı URL'de varsayılan resme dön
        if (previewImg) {
            previewImg.onerror = function() { this.src = "/img/default-user.png"; };
        }

        // İsim Soyisim Önizleme
        const updateNamePreview = () => {
            const name = nameInput ? nameInput.value : "";
            const surname = surnameInput ? surnameInput.value : "";
            const display = document.getElementById('namePreview');
            if (display) display.innerText = name + " " + surname;
        };

        if (nameInput) nameInput.addEventListener('input', updateNamePreview);
        if (surnameInput) surnameInput.addEventListener('input', updateNamePreview);

        // Kullanıcı Adı Önizleme - @@ Kaçış karakteri eklendi
        if (usernameInput) {
            usernameInput.addEventListener('input', function() {
                const userDisplay = document.getElementById('usernamePreview');
                if (userDisplay) userDisplay.innerText = "@@" + this.value;
            });
        }
    });
</script>