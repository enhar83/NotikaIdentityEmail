@using Entity_Layer.DTOs.AppUserDtos.ProfileDtos
@model EditProfileDto

@{
    ViewData["Title"] = "Profil Düzenleme";
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Profil Düzenleme</h2>
                        <p>Lütfen bilgilerinizi eksiksiz olarak doldurup güncelleme işlemini yapınız.</p>
                    </div>

                    @* Başarı mesajı varsa gösteriyoruz *@
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @* Genel hataları en üstte topluca göstermek için *@
                    <div asp-validation-summary="ModelOnly" class="text-danger m-b-20"></div>

                    <form asp-action="ChangePassword" asp-controller="Profile" method="post">
                        @* Güncelleme işlemi için kullanıcının ID'sini hidden olarak taşımalıyız *@
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            @* Adınız *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Adınız</label>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="Name" class="form-control" placeholder="Adınız">
                                    </div>
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>

                            @* Soyadınız *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Soyadınız</label>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="Surname" class="form-control" placeholder="Soyadınız">
                                    </div>
                                    <span asp-validation-for="Surname" class="text-danger"></span>
                                </div>
                            </div>

                            @* Şehriniz *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Şehriniz</label>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="City" class="form-control" placeholder="Şehiriniz">
                                    </div>
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>
                            </div>

                            @* Fotoğraf URL *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Fotoğraf URL</label>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="ImageUrl" class="form-control" placeholder="Fotoğraf Url">
                                    </div>
                                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                                </div>
                            </div>

                            @* Kullanıcı Adı *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Kullanıcı Adınız</label>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="UserName" class="form-control" placeholder="Kullanıcı Adınız">
                                    </div>
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                </div>
                            </div>

                            @* Email Adresi *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Email Adresiniz</label>
                                    <div class="nk-int-st">
                                        <input type="email" asp-for="Email" class="form-control" placeholder="Email Adresiniz">
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            @* Telefon Numarası *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Telefon Numaranız</label>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="PhoneNumber" class="form-control" placeholder="Telefon Numaranız">
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>

                            @* Güncelleme Butonu *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <button type="submit" class="btn btn-success">Bilgileri Güncelle</button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-danger {
        color: #ff0000 !important;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }
</style>