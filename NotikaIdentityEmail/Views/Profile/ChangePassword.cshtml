@using Entity_Layer.DTOs.AppUserDtos.ProfileDtos
@model ChangePasswordDto

@{
    ViewData["Title"] = "Şifre Değiştirme Sayfası";
    Layout = "~/Views/UserLayout/Index.cshtml";
}


<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Şifre Değiştirme Sayfası</h2>
                        <p>Lütfen eski şifrenizi eksiksiz olarak doldurup güncelleme işlemini yapınız.</p>
                    </div>

                    @* Genel hataları en üstte topluca göstermek için *@
                    <div asp-validation-summary="ModelOnly" class="text-danger m-b-20"></div>

                    <form asp-action="ChangePassword" asp-controller="Profile" method="post">
                        @* Güncelleme işlemi için kullanıcının ID'sini hidden olarak taşımalıyız *@
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Mevcut Şifreniz</label>
                                    <div class="nk-int-st">
                                        <input type="password" asp-for="CurrentPassword" class="form-control" placeholder="Mevcut Şifreniz">
                                    </div>
                                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Yeni Şifreniz</label>
                                    <div class="nk-int-st">
                                        <input type="password" asp-for="NewPassword" class="form-control" placeholder="Yeni Şifreniz">
                                    </div>
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Yeni Şifreniz Tekrar</label>
                                    <div class="nk-int-st">
                                        <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Yeni Şifreniz Tekrar">
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>

                            @* Güncelleme Butonu *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <div class="nk-int-st">
                                        <button type="submit" class="btn btn-success">Şifreyi Güncelle</button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-danger {
        color: #ff0000 !important;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }
</style>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

