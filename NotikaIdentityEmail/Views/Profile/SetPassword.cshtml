@using Entity_Layer.DTOs.AppUserDtos.ProfileDtos
@model SetPasswordDto

@{
	ViewData["Title"] = "SetPassword";
	Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="form-element-area">
	<div class="container">
		<div class="row">
			<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
				<div class="form-element-list">
					<div class="basic-tb-hd">
						<h2>Şifre Belirleme Sayfası</h2>
						<p>Lütfen şifre bilgilerinizi eksiksiz olarak doldurup şifre belirleme işlemini yapınız.</p>
						<p>Eğer şifrenizi önceden belirlediyseniz hata alacaksınız. Lütfen şifre değiştir kısmından yapınız.</p>
					</div>

					@if (TempData["SuccessExternalLoginMessage"] != null)
					{
						<div class="alert alert-success text-center m-b-20" style="background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; padding: 10px; border-radius: 5px; font-size: 14px;">
							<i class="fa fa-check-circle m-r-5"></i> @TempData["SuccessExternalLoginMessage"]
						</div>
					}

					<div asp-validation-summary="ModelOnly" class="text-danger m-b-20"></div>

					<form asp-action="SetPassword" asp-controller="Profile" method="post">
						<div class="form-group">
							<label>E-Posta Adresiniz</label>
							<div class="nk-int-st">
								<input type="text" asp-for="Email" class="form-control" readonly style="background-color: #eee;">
							</div>
						</div>

						<div class="row">
							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<label>Şifreniz</label>
									<div class="nk-int-st">
										<input type="password" asp-for="Password" class="form-control" placeholder="Mevcut Şifreniz">
									</div>
									<span asp-validation-for="Password" class="text-danger"></span>
								</div>
							</div>

							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<label>Şifreniz Tekrar</label>
									<div class="nk-int-st">
										<input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Yeni Şifreniz">
									</div>
									<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
								</div>
							</div>

							<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
								<div class="form-group">
									<div class="nk-int-st">
										<button type="submit" class="btn btn-success">Şifreyi Güncelle</button>
									</div>
								</div>
							</div>

						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.text-danger {
		color: #ff0000 !important;
		font-size: 12px;
		margin-top: 5px;
		display: block;
	}
</style>

@section Scripts {
	<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
	<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

