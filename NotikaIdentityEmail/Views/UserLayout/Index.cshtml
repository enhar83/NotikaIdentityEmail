
@{
    Layout = null;
}

<!doctype html>
<html class="no-js" lang="">

@await Component.InvokeAsync("_UserLayoutHeadComponenPartial");

<body>

    @await Component.InvokeAsync("_UserLayoutHeaderComponentPartial")

    @await Component.InvokeAsync("_UserLayoutMobileMenuComponentPartial")

    @await Component.InvokeAsync("_UserLayoutNavbarComponentPartial")

    @await Component.InvokeAsync("_UserLayoutBreadcombAreaComponentPartial")

    @RenderBody()

    @await Component.InvokeAsync("_UserLayoutFooterComponentPartial")

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
