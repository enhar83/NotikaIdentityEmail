@using Entity_Layer.DTOs.AppUserDtos.ForgotPasswordDtos
@model ResetPasswordDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Yeni Şifre Belirle | SmartShopper</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center" style="margin-top:100px;">
            <div class="col-md-5">
                <div class="card shadow border-0">
                    <div class="card-header bg-success text-white text-center py-3">
                        <h4 class="mb-0">Yeni Şifre Oluştur</h4>
                    </div>
                    <div class="card-body p-4">
                        <form method="post">
                            @* KRİTİK: Id ve Token bilgilerini kullanıcı görmez ama sistemin çalışması için gizli (hidden) olarak tutulmalıdır *@
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="Token" />

                            <div class="form-group mb-3">
                                <label class="form-label text-muted small">Şifresi Sıfırlanacak Hesap</label>
                                <input type="text" asp-for="Email" class="form-control bg-light" readonly />
                            </div>

                            <hr />

                            <div class="form-group mb-3">
                                <label asp-for="NewPassword" class="form-label">Yeni Şifreniz</label>
                                <input type="password" asp-for="NewPassword" class="form-control" placeholder="******" required />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ConfirmNewPassword" class="form-label">Yeni Şifre (Tekrar)</label>
                                <input type="password" asp-for="ConfirmNewPassword" class="form-control" placeholder="******" required />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>

                            @* Sunucu tarafında (Manager'da) oluşabilecek hataları burada gösteririz *@
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-success btn-lg">
                                    Şifremi Güncelle
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="card-footer text-center bg-white border-0 pb-3">
                        <a href="/Login/Signin" class="text-decoration-none text-muted small">Vazgeç ve Giriş Sayfasına Dön</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Client-side Validation scriptleri (Sayfa yenilenmeden şifre uyuşmazlığını yakalar) *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>